# ═══════════════════════════════════════════════════
# ResumePro — Environment Variables
# Copy this file to .env.local and fill in your keys
# NEVER commit .env.local to GitHub!
# ═══════════════════════════════════════════════════

# ── Anthropic (Claude AI) ──────────────────────────
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Razorpay ──────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys for testing, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_your-key-here
RAZORPAY_KEY_SECRET=your-secret-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# Expose key ID to frontend (safe — it's public-facing)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-here

# ── App Config ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ResumePro
NEXT_PUBLIC_PRICE_PAISE=19900
